# ** copy to .env and fill in real values, never commit .env
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long random string, e.g. `openssl rand -hex 48`>
JWT_EXPIRES_IN=1d

# ** gmail account + app password used for notification emails
EMAIL_ID=awardingbody@cutm.ac.in
EMAIL_PASSWORD=<gmail app password>

# ** number of proxies in front of the api (1 = the Next.js server); used for client IPs in rate limits and audit logs
TRUST_PROXY=1

# ** RailTel ToA payments: razorpay (live/test keys from the Razorpay dashboard) or mock (development only)
TOA_PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ** webhook URL to register in Razorpay: <api>/api/v1/toa/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ** frontend address, used for links in emails
FRONTEND_URL=http://localhost:3000

# ** redis for bullmq (certificate + email queues)
REDIS_URL=redis://127.0.0.1:6379
# ** set false when running `npm run worker` as a separate process
RUN_WORKERS_IN_PROCESS=true

# ** comma separated frontend origins, empty allows every origin
CORS_ORIGINS=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# ** optional, an S3 compatible endpoint (MinIO / LocalStack) for local development
AWS_S3_ENDPOINT=
# ** public-read keeps current frontend links working, use private once signed urls are added
S3_OBJECT_ACL=public-read
MAX_UPLOAD_SIZE_MB=10
